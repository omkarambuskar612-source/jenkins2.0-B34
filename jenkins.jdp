
pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git branch: 'main', url: 'https://github.com/omkarambuskar612-source/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                dir('backend') {
                    sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar   -Dsonar.projectKey=testing-project   -Dsonar.projectName=\'testing-project\'   -Dsonar.host.url=http:// 13.127.131.216:9000   -Dsonar.token=sqp_c5ccb735be324d19f4ec8c1f5d4b9bc3317843ce'    
                }
         echo 'TEST SUCCESS'
            }
        }

        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
