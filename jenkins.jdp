pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git branch: 'main', url: 'https://github.com/omkarambuskar612-source/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean packege -DiskipTests'
                }
                echo 'BUILD SUCCESS'
        }

        stage('TEST') {
            steps {
                echo 'TEST SUCCESS'
            }
        }

        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
