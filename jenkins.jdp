
pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/omkarambuskar612-source/jenkins2.0-B34.git'

                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }

                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                echo 'TEST SUCCESS'
            }
        }

        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'sonar-cred'
                echo 'QUALITY-PASSED'
                }

                echo 'QUALITY-PASSED'                 
	    }    
        }

        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}

