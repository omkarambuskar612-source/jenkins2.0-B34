pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/omkarambuskar612-source/jenkins2.0-B34.git'

                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }

                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'Sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=testing-project \
                            -Dsonar.projectName='testing-project'
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }

        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'sonar-cred'
                echo 'QUALITY-PASSED'
                }

                echo 'QUALITY-PASSED'                 
	    }    
        }

        stage('Countinuous-dilevery') {
            steps {
                sh 'aws s3 cp /var/lib/jenkins/workspace/new-job-pipeline/backend/target/ student-registration-backend-0.0.1-SNAPSHOT.jar s3://my-testing-project1/studentapp.jar'
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}

